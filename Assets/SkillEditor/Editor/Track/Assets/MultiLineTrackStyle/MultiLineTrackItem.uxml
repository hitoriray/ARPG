<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="MultiLineTrackItem" style="height: 30px; margin-bottom: 2px; margin-top: 0; position: absolute; width: 100%;">
        <ui:TextField picking-mode="Ignore" text="轨道1" name="NameField" style="margin-left: 12px; margin-top: 0; margin-right: 5px; margin-bottom: 0; height: 30px; font-size: 13px; -unity-font-style: normal;" />
        <ui:Button text="X" display-tooltip-when-elided="true" name="DeleteBtn" style="position: absolute; top: 4px; right: 5px; width: 20px; height: 20px; -unity-font-style: normal; background-color: rgb(152, 19, 19); font-size: 12px; -unity-text-align: middle-center; white-space: nowrap;" />
    </ui:VisualElement>
</ui:UXML>
